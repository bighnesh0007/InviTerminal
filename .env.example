# InviTerminal — local environment. Copy this file to ".env" and fill it in.
#   cp .env.example .env
# The real ".env" is gitignored; never commit your key. A real environment
# variable (if already exported) takes precedence over the value here.

# Your free Groq API key from https://console.groq.com (starts with gsk_).
# When set here, the app uses it directly and you never paste it into Settings.
GROQ_API_KEY=

# Optional: default AI model. Omit to use the cheapest/default (llama-3.1-8b-instant).
# One of: llama-3.1-8b-instant | llama-3.3-70b-versatile | openai/gpt-oss-20b | openai/gpt-oss-120b
# INVI_AI_MODEL=llama-3.1-8b-instant

# Optional: fixed LAN port for "Share to phone" (so one firewall rule keeps working).
# INVI_COMPANION_PORT=41830
